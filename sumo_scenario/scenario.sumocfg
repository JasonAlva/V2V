<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="../data/sumo_map.net.xml"/>
    <route-files value="scenario.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
  </time>
  <processing>
    <collision.action value="warn"/>
    <time-to-teleport value="-1"/>
    <step-length value="0.05"/>
  </processing>
  <report>
    <verbose value="false"/>
    <no-step-log value="true"/>
  </report>
</configuration>
