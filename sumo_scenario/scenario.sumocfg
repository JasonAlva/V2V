<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file   value="scenario.net.xml"/>
    <route-files value="scenario.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end   value="7200"/>
  </time>
  <processing>
    <collision.action   value="warn"/>
    <time-to-teleport   value="-1"/>
    <step-length        value="0.05"/>
    <!-- Keep vehicles in simulation even after they finish their route -->
    <ignore-route-errors value="true"/>
  </processing>
  <report>
    <verbose     value="false"/>
    <no-step-log value="true"/>
  </report>
</configuration>
